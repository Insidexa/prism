# Prism: let idle laptop devices power down (PCI runtime power management).
# The kernel leaves these "on" (always powered) unless told otherwise; with
# "auto" each one sleeps while unused and wakes by itself when needed:
#   - the Realtek wired Ethernet port while no cable is plugged in,
#   - the SD card reader while no card is in,
#   - USB controllers with nothing (or only sleeping devices) attached.
# Wi-Fi is left alone (rtw89 cards can drop out with aggressive power saving),
# and so are USB devices themselves, so mice and receivers never lag.
ACTION=="add|bind", SUBSYSTEM=="pci", DRIVER=="r8169", ATTR{power/control}="auto"
ACTION=="add|bind", SUBSYSTEM=="pci", DRIVER=="sdhci-pci", ATTR{power/control}="auto"
ACTION=="add|bind", SUBSYSTEM=="pci", DRIVER=="xhci_hcd", ATTR{power/control}="auto"
